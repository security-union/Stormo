// Stromo data-plane stream header (DD-7, incl. the message-channel
// amendment).
//
// On the message channel (stream tag 0x02) every message is a size-prefixed
// StreamHeader followed by a size-prefixed payload. On dedicated streams
// (tag 0x01) the size-prefixed StreamHeader comes first and stream FIN
// delimits the payload. The control stream (tag 0x00) carries Signal
// messages instead (signal.fbs) because signaling requires total order.
//
// Same evolution discipline as signal.fbs (DD-5): append-only field ids,
// append-only enum values, verifier + caps on every inbound read.
//
// Codegen (flatc version pinned in flake.nix, matched exactly by Package.swift):
//   flatc --swift -o Sources/StromoProtocol/Generated Schemas/*.fbs

include "common.fbs";

namespace Stromo.Wire;

enum StreamKind: ubyte {
  Unknown = 0,
  /// Reliable message, unordered across messages (FR-15 `.reliable`).
  Message = 1,
  /// Reliable message with FIFO ordering via `sequence` (FR-15 `.reliableOrdered`).
  OrderedMessage = 2,
  /// Resource-transfer chunk stream (FR-17); `transfer_id` pairs it with the
  /// TransferOffer signal sent on the control stream.
  TransferChunk = 3,
  /// Application-opened named byte stream (FR-18).
  AppStream = 4,
  /// Unreliable-semantics message (FR-16 `.datagram`) riding the message
  /// channel — the floor-compatible mapping; RFC 9221 QUIC datagrams
  /// (iOS 16+/macOS 13+) are the latency refinement (TODO datagrams).
  Datagram = 5,
}

table StreamHeader {
  kind:StreamKind (id: 0);
  /// Sender-local FIFO sequence, per peer pair. Meaningful for OrderedMessage.
  sequence:ulong (id: 1);
  /// Meaningful for TransferChunk.
  transfer_id:TransferId (id: 2);
  /// The app-chosen stream name. Meaningful for AppStream.
  label:string (id: 3);
}

root_type StreamHeader;
